{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/.well-known/:file", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
    { "source": "/auth/callback", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/recuperar-password", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "Cache-Control", "value": "no-store" }] }
  ],
  "rewrites": [{ "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }]
}
