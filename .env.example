# Plantilla de variables de entorno. No contiene credenciales reales.
#
# Desarrollo local:
#   copia este archivo como .env.local y completa los valores de tu proyecto.
#
# Vercel:
#   define las mismas variables en Project Settings -> Environment Variables
#   para Production, Preview y Development.
#
# La clave anónima es pública por diseño (las políticas RLS protegen los datos).
# Nunca uses aquí la clave service_role ni secretos de correo.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima
